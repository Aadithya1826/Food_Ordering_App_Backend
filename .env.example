DATABASE_URL=postgresql://user:password@localhost:5432/food_ordering_db
SECRET_KEY=generate_your_own_secure_secret
ENVIRONMENT=development

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
